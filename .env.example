# Supabase "Pampojo" -> Connect -> Direct connection string -> Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Same dialog -> Session pooler (port 5432). Used by drizzle-kit for migrations.
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Session signing secret, at least 32 chars: `openssl rand -base64 32`. Same value in every environment.
BETTER_AUTH_SECRET=
# Public base URL of the app. Set it in Vercel Production only; locally and on previews it is derived.
# BETTER_AUTH_URL=https://pampojo.vercel.app
# Google OAuth "Web application" client. Leave unset to hide Google sign-in (always hidden on previews).
# Redirect URIs: http://localhost:3000/api/auth/callback/google and <prod URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Supabase "Pampojo" -> Connect (or Project Settings -> Data API) -> Project URL. Builds public URLs of exercise images.
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings -> API Keys -> Secret keys (sb_secret_…), or the legacy service_role key.
# Only for `pnpm db:seed:media` on your machine; never in Vercel or CI.
# SUPABASE_SERVICE_ROLE_KEY=
